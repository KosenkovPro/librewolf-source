{
  "manifest_version": 2,
  "name": "LibreWolf Screenshot",
  "description": "Captures a part of the screen or the whole page, annotates it and saves it as a picture, a pdf or a single html file.",
  "version": "1.0.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "librewolf-screenshot@librewolf.net",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "downloads",
    "storage",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js", "pdf.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_title": "Screenshot",
    "default_icon": "icons/icon.svg"
  },

  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Take a screenshot of the page"
    }
  }
}
