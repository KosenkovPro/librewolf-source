{
  "manifest_version": 2,
  "name": "LibreWolf Dark Mode",
  "description": "Forces a dark theme on every website, with brightness and contrast settings.",
  "version": "1.0.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "librewolf-darkmode@librewolf.net",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_title": "Dark mode",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },

  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Turn the dark mode on or off"
    }
  }
}
