{
  "manifest_version": 2,
  "name": "LibreWolf Color Picker",
  "description": "Pick a color from any page and copy it as HEX, RGB or HSL.",
  "version": "1.0.1",

  "browser_specific_settings": {
    "gecko": {
      "id": "librewolf-colorpicker@librewolf.net",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "storage",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_title": "Pick a color",
    "default_icon": "icons/icon.svg"
  },

  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Pick a color from the page"
    }
  }
}
